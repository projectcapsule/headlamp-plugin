{
  "name": "capsule",
  "version": "0.1.0-beta1",
  "description": "Capsule multi-tenancy plugin for Headlamp. Tenant switcher, scoped namespace filtering by tenant, per-tenant namespace overview, visualization for CustomQuotas / GlobalCustomQuotas, and TenantResources / GlobalTenantResources (with SSA managed fields maps per resource).",
  "homepage": "https://projectcapsule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projectcapsule/headlamp-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/projectcapsule/headlamp-plugin/issues"
  },
  "author": "Project Capsule Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "vite build --config vite.config.mjs",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "headlamp-plugin test"
  },
  "keywords": [
    "headlamp",
    "capsule",
    "multi-tenancy"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  },
  "dependencies": {
    "@rjsf/core": "^5.24.13",
    "@rjsf/mui": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "recharts": "^3.8.1"
  }
}
